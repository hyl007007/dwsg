# Copy to /userdata/dwsg/config/game.env; use the board's reserved LAN address.
DWSG_WORLD_DB=/var/lib/dwsg/world.sqlite
DWSG_WORLD_SEED=/var/lib/dwsg/seed.json
DWSG_WORLD_ID=main
DWSG_AUTH_URL=http://127.0.0.1:18080/api.php?appid=1
ASPNETCORE_URLS=http://192.168.1.119:18081;http://127.0.0.1:18081
DWSG_MAX_ONLINE_PLAYERS=5
DOTNET_gcServer=1
DOTNET_GCHeapCount=2
Logging__LogLevel__Default=Warning
